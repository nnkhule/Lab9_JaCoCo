digraph scholarship_cfg {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.48",
        label="scholarship(gpa, credits, hasViolation)", labelloc=t,
        fontname="Arial", fontsize=18];
  node [fontname="Arial", fontsize=10, color="#334155", fontcolor="#0f172a",
        penwidth=1.2, style="filled", fillcolor="#f8fafc"];
  edge [fontname="Arial", fontsize=8, color="#475569", fontcolor="#334155",
        arrowsize=0.7];

  start [shape=circle, label="Start", fillcolor="#dbeafe"];
  invalid0 [shape=diamond, label="gpa < 0?\nOR condition 1"];
  invalid4 [shape=diamond, label="gpa > 4?\nOR condition 2"];
  invalidCredits [shape=diamond, label="credits < 0?\nOR condition 3"];
  bad [shape=box, label="throw IllegalArgumentException", fillcolor="#fee2e2"];
  violation [shape=diamond, label="hasViolation?"];
  zeroViolation [shape=box, label="return 0"];
  gpa38 [shape=diamond, label="gpa >= 3.8?"];
  credits15 [shape=diamond, label="credits >= 15?"];
  hundred [shape=box, label="return 100", fillcolor="#dcfce7"];
  gpa34 [shape=diamond, label="gpa >= 3.4?"];
  credits12 [shape=diamond, label="credits >= 12?"];
  seventy [shape=box, label="return 70", fillcolor="#dcfce7"];
  gpa30 [shape=diamond, label="gpa >= 3.0?"];
  fifty [shape=box, label="return 50", fillcolor="#dcfce7"];
  zero [shape=box, label="return 0", fillcolor="#e2e8f0"];

  start -> invalid0;
  invalid0 -> bad [label="true: scholarshipGpaBelowZeroThrows"];
  invalid0 -> invalid4 [label="false: scholarshipFull"];
  invalid4 -> bad [label="true: scholarshipGpaAboveFourThrows"];
  invalid4 -> invalidCredits [label="false: scholarshipFull"];
  invalidCredits -> bad [label="true: scholarshipNegativeCreditsThrows"];
  invalidCredits -> violation [label="false: scholarshipFull"];
  violation -> zeroViolation [label="true: scholarshipViolation"];
  violation -> gpa38 [label="false: scholarshipFull"];
  gpa38 -> credits15 [label="true: scholarshipFull"];
  gpa38 -> gpa34 [label="false: scholarshipGpaBelowThirtyFourGetsFifty"];
  credits15 -> hundred [label="true: scholarshipFull"];
  credits15 -> gpa34 [label="false: scholarshipGpaQualifiesButCreditsBelowFifteen"];
  gpa34 -> credits12 [label="true: scholarshipPartial"];
  gpa34 -> gpa30 [label="false: scholarshipGpaBelowThirtyFourGetsFifty"];
  credits12 -> seventy [label="true: scholarshipPartial"];
  credits12 -> gpa30 [label="false: scholarshipGpaQualifiesButCreditsBelowTwelve"];
  gpa30 -> fifty [label="true: scholarshipPartial"];
  gpa30 -> zero [label="false: scholarshipGpaBelowThreeGetsZero"];
}
